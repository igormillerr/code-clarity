{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codeclarity:review:1",
  "title": "CodeClarity LLM review exchange v1 (proposed integration contract)",
  "type": "object",
  "required": [
    "schemaVersion",
    "reviewId",
    "scope",
    "independentReview",
    "metrics",
    "findings",
    "coverage",
    "skips",
    "verdict",
    "ruleDiscovery"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "reviewId": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "required": [
        "repoRoot",
        "baseSha",
        "headSha",
        "snapshotId",
        "languages",
        "paths"
      ],
      "properties": {
        "repoRoot": {
          "type": "string",
          "minLength": 1
        },
        "baseSha": {
          "type": "string",
          "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "headSha": {
          "type": "string",
          "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "snapshotId": {
          "type": "string",
          "minLength": 1
        },
        "languages": {
          "type": "array",
          "items": {
            "enum": [
              "java",
              "python"
            ]
          },
          "uniqueItems": true
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "independentReview": {
      "type": "object",
      "required": [
        "status",
        "artifact",
        "coverage",
        "findings"
      ],
      "properties": {
        "status": {
          "enum": [
            "COMPLETE",
            "INCOMPLETE"
          ]
        },
        "artifact": {
          "type": "string",
          "minLength": 1
        },
        "coverage": {
          "type": "object",
          "required": [
            "filesExpected",
            "filesReviewed",
            "entitiesExpected",
            "entitiesReviewed"
          ],
          "properties": {
            "filesExpected": {
              "type": "integer",
              "minimum": 0
            },
            "filesReviewed": {
              "type": "integer",
              "minimum": 0
            },
            "entitiesExpected": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "entitiesReviewed": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        }
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/comparison"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "coverage": {
      "type": "object",
      "required": [
        "filesExpected",
        "filesAnalyzed",
        "entitiesExpected",
        "entitiesAnalyzed"
      ],
      "properties": {
        "filesExpected": {
          "type": "integer",
          "minimum": 0
        },
        "filesAnalyzed": {
          "type": "integer",
          "minimum": 0
        },
        "entitiesExpected": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "entitiesAnalyzed": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "skips": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "stage",
          "reason"
        ],
        "properties": {
          "stage": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "verdict": {
      "enum": [
        "PASS",
        "WARN",
        "INCOMPLETE",
        "NO_CHANGES"
      ]
    },
    "ruleDiscovery": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "NOT_RUN",
            "RULE_SUGGESTED",
            "NO_SUGGESTION",
            "UNAVAILABLE",
            "ERROR"
          ]
        },
        "candidate": {
          "type": "object"
        },
        "reason": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "definition": {
      "type": "object",
      "required": [
        "id",
        "language",
        "analyzer",
        "algorithm"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "language": {
          "enum": [
            "java",
            "python"
          ]
        },
        "analyzer": {
          "type": "string",
          "minLength": 1
        },
        "algorithm": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "value": {
      "type": "object",
      "required": [
        "definition",
        "status"
      ],
      "properties": {
        "definition": {
          "$ref": "#/$defs/definition"
        },
        "status": {
          "enum": [
            "AVAILABLE",
            "UNSUPPORTED",
            "MISSING",
            "ERROR",
            "ENTITY_ABSENT"
          ]
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "AVAILABLE"
              }
            }
          },
          "then": {
            "required": [
              "value"
            ],
            "properties": {
              "value": {
                "type": "number"
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "comparison": {
      "type": "object",
      "required": [
        "path",
        "entity",
        "metric",
        "status",
        "before",
        "after"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "entity": {
          "type": "string"
        },
        "metric": {
          "enum": [
            "cyclomatic_complexity",
            "cognitive_complexity",
            "function_sloc",
            "max_nesting_depth",
            "parameter_count",
            "return_count"
          ]
        },
        "status": {
          "enum": [
            "COMPARED",
            "INCOMPATIBLE",
            "UNAVAILABLE"
          ]
        },
        "before": {
          "$ref": "#/$defs/value"
        },
        "after": {
          "$ref": "#/$defs/value"
        },
        "delta": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "finding": {
      "type": "object",
      "required": [
        "findingId",
        "reviewId",
        "snapshotId",
        "source",
        "categoryId",
        "location",
        "evidence",
        "description",
        "recommendation",
        "metricRelation",
        "reviewStatus"
      ],
      "properties": {
        "findingId": {
          "type": "string",
          "minLength": 1
        },
        "reviewId": {
          "type": "string",
          "minLength": 1
        },
        "snapshotId": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "enum": [
            "AI_REVIEW",
            "METRIC_SIGNAL"
          ]
        },
        "categoryId": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "object",
          "required": [
            "path",
            "startLine",
            "endLine"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "startLine": {
              "type": "integer",
              "minimum": 1
            },
            "endLine": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "recommendation": {
          "type": "string",
          "minLength": 1
        },
        "metricRelation": {
          "enum": [
            "SUPPORTED",
            "UNRELATED",
            "INSUFFICIENT_DATA"
          ]
        },
        "reviewStatus": {
          "const": "PENDING_FEEDBACK"
        },
        "originFindingIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
