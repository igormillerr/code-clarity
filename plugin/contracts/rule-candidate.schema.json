{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codeclarity:rule-candidate-request:1",
  "title": "Persist an evidence-backed proposal without activating a rule",
  "type": "object", "additionalProperties": false, "required": ["candidate"],
  "properties": {"candidate": {"$ref": "#/$defs/candidate"}},
  "$defs": {
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["candidateId", "categoryId", "status", "title", "description", "supportingFindingIds", "confirmedFeedbackIds", "examples", "exceptions"],
      "properties": {
        "candidateId": {"type": "string", "minLength": 1},
        "categoryId": {"type": "string", "minLength": 1},
        "status": {"const": "PROPOSED"},
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "supportingFindingIds": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "confirmedFeedbackIds": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "examples": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/example"}},
        "exceptions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "synthetic": {"const": false}
      }
    },
    "example": {
      "type": "object", "additionalProperties": false, "required": ["findingId"],
      "properties": {
        "findingId": {"type": "string", "minLength": 1},
        "reviewId": {"type": "string", "minLength": 1},
        "snapshotId": {"type": "string", "minLength": 1},
        "location": {"type": "object"},
        "description": {"type": "string"},
        "recommendation": {"type": "string"},
        "evidence": {"type": "array"}
      }
    }
  }
}
